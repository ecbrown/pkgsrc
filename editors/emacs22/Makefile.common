# $NetBSD: Makefile.common,v 1.7 2016/12/30 22:25:46 wiz Exp $
#
# used by editors/emacs22/Makefile
# used by editors/emacs22-nox11/Makefile

COMMENT?=	GNU editing macros (editor)

DISTNAME=	emacs-22.3
PKGNAME?=	${DISTNAME:S/emacs/emacs22/}
CATEGORIES=	editors
MASTER_SITES=	${MASTER_SITE_GNU:=emacs/}

MAINTAINER=	pkgsrc-users@NetBSD.org
HOMEPAGE=	http://www.gnu.org/software/emacs/emacs.html
LICENSE=	gnu-gpl-v3

CONFLICTS+=	elisp-manual-[0-9]*
CONFLICTS+=	mule-[0-9]*

.include "../../mk/bsd.prefs.mk"

.if ${OPSYS} == "OpenVMS"
# The VMS source tree has its own DCL configure script and MMS description.
# Keep the native DECwindows build self-contained: DECW$ headers and the
# shareable X library are supplied by the operating system, rather than by
# pkgsrc's Unix X11 buildlink files.
USE_TOOLS+=		grep patch readlink
HAS_CONFIGURE=		yes
CONFIGURE_SCRIPT=	./configure.com
MAKE_FILE=		Descrip.MMS
PATCHDIR=
# The VMS file-spec parser treats a dot in a directory component specially
# (the extracted emacs-22.3 directory becomes emacs-22^.3).  Use a dot-free
# work directory like the existing native EMACS223 build.  PKGSRCDIR may
# contain ../ components, and .CURDIR can acquire those components again at
# recursive phase barriers; GNV then fails to reopen its own work files.  A
# canonical pkgsrc root keeps the pathname both short and stable, while
# PKGPATH keeps the X and no-X packages in separate work directories.
# Recursive barrier makes can inherit a lexical PWD containing ../ even after
# cd reaches the right directory.  GNV bmake cannot reopen generated files
# through that spelling, so canonicalize the name itself instead of trusting
# the shell's logical PWD cache.
EMACS22_VMS_PKGSRCDIR!=		${TOOLS_PLATFORM.readlink} -f ${PKGSRCDIR:Q}
WRKDIR=		${EMACS22_VMS_PKGSRCDIR}/${PKGPATH}/work
WRKSRC=		${WRKDIR}/emacs223
# GNV cannot reopen the device-qualified .CURDIR spelling emitted by bmake;
# use the logical pkgsrc root for files consumed by the framework.
FILESDIR=		${PKGSRCDIR}/editors/emacs22/files
DISTINFO_FILE=		${PKGSRCDIR}/editors/emacs22/files/distinfo-vms

# bmake's physical .CURDIR spelling contains a dollar sign when the tree is
# on a VMS logical device.  Keep package metadata rooted at the logical
# pkgsrc path so DESCR/PLIST lookups survive recursive phase barriers.
PKGDIR=		${PKGSRCDIR}/editors/emacs22
DESCR_SRC=		${PKGDIR}/DESCR

# The builder uses native Perl to translate pkgsrc's POSIX staging path and to
# turn that build-time path into a relocation marker.  Binary-package installs
# use the small packaged C helper instead and do not require Perl.
EMACS22_VMS_NATIVE_PERL?=	/PERL_ROOT/000000/PERL.EXE
EMACS22_VMS_PREFIX_CMD=	${EMACS22_VMS_NATIVE_PERL:Q} -MVMS::Filespec -e \
		'print VMS::Filespec::vmspath("${DESTDIR}${PREFIX}")'
EMACS22_VMS_PREFIX=	${EMACS22_VMS_PREFIX_CMD:sh}
EMACS22_VMS_STAGE_DUMP=	${EMACS22_VMS_PREFIX:C/\]$/.BIN]EMACS-22_3.DUMP/}
EMACS22_VMS_STAGE_DUMP_RAW=	${EMACS22_VMS_PREFIX:C/\]$/.BIN]EMACS-22_3.DUMP-PKGSRC/}
EMACS22_VMS_STAGE_STARTUP=	${EMACS22_VMS_PREFIX:C/\]$/.STARTUP]/}
EMACS22_VMS_STAGE_STARTUP_FILE=	${EMACS22_VMS_STAGE_STARTUP}EMACS-22_3_STARTUP.COM
EMACS22_VMS_STAGE_STARTUP_RAW=	${EMACS22_VMS_STAGE_STARTUP}EMACS-22_3_STARTUP.COM-PKGSRC

EMACS22_WITH_X?=	YES
.if ${EMACS22_WITH_X} == "YES"
EMACS22_VMS_X_ARGS=	--WITH-X=YES --WITH-X-TOOLKIT=MOTIF
.else
EMACS22_VMS_X_ARGS=	--WITH-X=NO --WITH-X-TOOLKIT=NO
.endif

# The VMS install target enumerates the architecture-independent lisp and
# documentation files itself.  Generate the final list from the staged tree.
PLIST_TYPE=		dynamic
# Native VMS installation spells the info directory and its shared index in
# uppercase.  Treat the individual pages as INFO_FILES, but never package the
# shared INFO/DIR index; pkg_add must update the existing index in place.
INFO_FILES=		yes
PKGINFODIR=		INFO
# The generated +INSTALL/+DEINSTALL scripts update the shared Info index at
# package operation time, so this is a runtime dependency, not just a tool.
USE_TOOLS+=		install-info:run
DEPENDS+=		pkg_install-info>=4.5nb4:../../pkgtools/pkg_install-info
INSTALL_INFO=		${PREFIX}/bin/pkg_install-info
# pkg_install's portable archive format does not carry OpenVMS RMS record
# metadata.  Keep immutable raw/template sidecars in the package and let the
# install script materialize the runnable files at the target's PKG_PREFIX.
# This preserves package checksums and supports binary-package relocation.
INSTALL_TEMPLATES+=	${FILESDIR}/vms-install
DEINSTALL_TEMPLATES+=	${FILESDIR}/vms-deinstall
# The executable has this path compiled in, so retain it independently of
# PKG_CONFIG and match the protection applied by the native MMS install.
REQD_DIRS_PERMS+=	${PREFIX}/lib/emacs/lock \
			${REAL_ROOT_USER} ${REAL_ROOT_GROUP} 0777
# site-lisp is an administrator extension point.  Reference-count the shared
# directory, preserve nonempty user content, and do not inherit a private
# builder umask.
MAKE_DIRS_PERMS+=	${PREFIX}/lib/emacs/site-lisp \
			${REAL_ROOT_USER} ${REAL_ROOT_GROUP} 0755

post-extract:
	${MKDIR} ${WRKSRC}
	${CP} -R ${WRKDIR}/${DISTNAME}/. ${WRKSRC}
	${RM} -rf ${WRKDIR}/${DISTNAME}
	${CP} -R ${FILESDIR}/vms-overlay/. ${WRKSRC}
	${CP} ${FILESDIR}/site-init.el ${WRKSRC}/lisp/site-init.el
	# OpenVMS patch(1) cannot rename its SYS$SCRATCH output across volumes.
	# Give it an explicit output beside the target, then install that file.
	${TOOLS_PLATFORM.patch} -d ${WRKSRC} -p0 \
		-o ${WRKSRC}/lisp/files.el.pkgsrc \
		< ${FILESDIR}/vms-patches/patch-lisp_files.el
	${MV} ${WRKSRC}/lisp/files.el.pkgsrc ${WRKSRC}/lisp/files.el
	${TOOLS_PLATFORM.patch} -d ${WRKSRC} -p0 \
		-o ${WRKSRC}/lisp/loadup.el.pkgsrc \
		< ${FILESDIR}/vms-patches/patch-lisp_loadup.el
	${MV} ${WRKSRC}/lisp/loadup.el.pkgsrc ${WRKSRC}/lisp/loadup.el
	${TOOLS_PLATFORM.patch} -d ${WRKSRC} -p0 \
		-o ${WRKSRC}/src/regex.c.pkgsrc \
		< ${FILESDIR}/vms-patches/patch-src_regex.c
	${MV} ${WRKSRC}/src/regex.c.pkgsrc ${WRKSRC}/src/regex.c
	${TOOLS_PLATFORM.patch} -d ${WRKSRC} -p0 \
		-o ${WRKSRC}/oldXMenu/Internal.c.pkgsrc \
		< ${FILESDIR}/vms-patches/patch-oldXMenu_Internal.c
	${MV} ${WRKSRC}/oldXMenu/Internal.c.pkgsrc ${WRKSRC}/oldXMenu/Internal.c
	# The distfile includes bytecode for patched VMS Lisp.  Let loadup preload
	# the corrected sources into the VMS dump instead.
	${RM} ${WRKSRC}/lisp/files.elc
	${RM} ${WRKSRC}/lisp/startup.elc
	${RM} ${WRKSRC}/lisp/vms-patch.elc
	${RM} ${WRKSRC}/lisp/vmsproc.elc
	${CHMOD} -R go-w ${WRKSRC}

do-configure:
	# GNV dcl's default output mode lets a spawned DCL/MMS process inherit
	# bmake's pipe directly.  Under a piped build the wrapper can then return
	# SS$_BADATTRIB before its child, leaving MMS compiling after bmake stops.
	# The supported -s mailbox mode waits for the child, keeps its output in
	# bmake's stream, and propagates the native completion status.
	${RUN} cd ${WRKSRC} && /bin/dcl -s \
		'@[.VMS]pkgsrc-configure.com ${EMACS22_VMS_PREFIX} ${EMACS22_WITH_X}'

pre-configure:
	${TEST} -x ${EMACS22_VMS_NATIVE_PERL:Q}
	${EMACS22_VMS_NATIVE_PERL:Q} -MVMS::Filespec -e \
		'use VMS::Filespec ();' && :

do-build:
	${RUN} cd ${WRKSRC} && /bin/dcl -s \
		'@[.VMS]pkgsrc-mms.com all ${EMACS22_VMS_PREFIX}'

do-install:
	${RUN} cd ${WRKSRC} && /bin/dcl -s \
		'@[.VMS]pkgsrc-mms.com install_no_database ${EMACS22_VMS_PREFIX}'

post-install:
	${INSTALL_DATA} ${FILESDIR}/vms-site-lisp-subdirs.el \
		${DESTDIR}${PREFIX}/lib/emacs/site-lisp/subdirs.el
	# install-info owns the shared index; carrying it in the binary package
	# prevents pkg_add from installing alongside any existing info package.
	${RM} -f ${DESTDIR}${PREFIX}/${PKGINFODIR}/DIR
	# Configure must use the staged prefix so MMS installs under DESTDIR.  Turn
	# its absolute prefix into a marker; +INSTALL expands the marker using the
	# target's PKG_PREFIX without modifying any package-owned file.
	${PKGSRC_SETENV} \
		EMACS22_STAGE_PREFIX=${EMACS22_VMS_PREFIX:Q} \
		${EMACS22_VMS_NATIVE_PERL:Q} -pi -e \
		'BEGIN { ($$from = $$ENV{EMACS22_STAGE_PREFIX}) =~ s/^[^:]*://; $$from =~ s/\]$$//; die "empty VMS stage prefix" if $$from eq ""; $$n = 0; } $$n += s/[-A-Za-z0-9_\x24^]+:\Q$$from\E/__PKGSRC_EMACS22_PREFIX__/ig; $$n += s/EMACS22_STAGE:\[000000/__PKGSRC_EMACS22_PREFIX__/ig; die "unreplaced VMS stage prefix" if index(uc($$_), uc($$from)) >= 0; END { die "startup prefix was not replaced" unless $$n; }' \
		${EMACS22_VMS_STAGE_STARTUP_FILE}
	${GREP} -q __PKGSRC_EMACS22_PREFIX__ \
		${DESTDIR}${PREFIX}/startup/EMACS-22_3_STARTUP.COM
	# EMACS22_STAGE remains intentionally as the runtime logical name; only
	# its build-time equivalence must be replaced above.
	! ${GREP} -Eiq '[.]DESTDIR' \
		${DESTDIR}${PREFIX}/startup/EMACS-22_3_STARTUP.COM
	${RUN} cd ${WRKSRC} && /bin/dcl -s \
		'@[.VMS]pkgsrc-stage-sidecar.com ${EMACS22_VMS_STAGE_STARTUP_FILE} ${EMACS22_VMS_STAGE_STARTUP_RAW}'
	${TEST} ! -e ${DESTDIR}${PREFIX}/startup/EMACS-22_3_STARTUP.COM
	${TEST} -f ${DESTDIR}${PREFIX}/startup/EMACS-22_3_STARTUP.COM-PKGSRC
	# Expose the dump's physical record-control words to pkg_create and retain
	# them in a checksum-stable sidecar.  +INSTALL copies this sidecar before
	# restoring VAR/NONE on the generated runtime dump.
	${RUN} cd ${WRKSRC} && /bin/dcl -s \
		'@[.VMS]pkgsrc-stage-sidecar.com ${EMACS22_VMS_STAGE_DUMP} ${EMACS22_VMS_STAGE_DUMP_RAW}'
	${TEST} ! -e ${DESTDIR}${PREFIX}/bin/emacs-22_3.dump
	${TEST} -f ${DESTDIR}${PREFIX}/bin/emacs-22_3.dump-pkgsrc
	${RUN} cd ${WRKSRC} && /bin/dcl -s \
		'@[.VMS]pkgsrc-set-file-attrs.com ${EMACS22_VMS_STAGE_DUMP_RAW}'
	# Provide the canonical GNV entry point expected by editors/emacs/modules.mk
	# and by dependent Lisp packages.
	${INSTALL_SCRIPT} ${FILESDIR}/vms-emacs \
		${DESTDIR}${PREFIX}/bin/emacs
.else
USE_TOOLS+=		gmake gzip mktemp:run perl:run pkg-config
GNU_CONFIGURE=		yes
INFO_FILES=		yes

SETGIDGAME=		yes

MAKEFLAGS+=		EMACSLOADPATH=${WRKSRC}/lisp

CONFIGURE_ARGS+=	--localstatedir=${VARBASE:Q}
CONFIGURE_ENV+=		GAMEOWN=${GAMEOWN:Q}

BUILD_DEFS+=		VARBASE
BUILD_DEFS+=		GAMEDATAMODE

# build PATH in the dumped emacs is not a problem
CHECK_WRKREF_SKIP+=	bin/emacs
CHECK_WRKREF_SKIP+=	bin/emacs-[0-9]*

REPLACE_PERL=		lib-src/grep-changelog

SUBST_CLASSES+=		test_equal
SUBST_STAGE.test_equal=	pre-configure
SUBST_MESSAGE.test_equal=	Fixing bashisms in test(1) usage.
SUBST_FILES.test_equal=	mac/make-package
SUBST_SED.test_equal=	-e 's/ == / = /g'

MAKE_DIRS_PERMS+=	${VARBASE}/games/emacs \
			${GAMES_USER} ${GAMES_GROUP} ${GAMEDIRMODE:Q}
CONF_FILES_PERMS+=	/dev/null ${VARBASE}/games/emacs/snake-scores \
			${GAMES_USER} ${GAMES_GROUP} ${GAMEDATAMODE:Q}
CONF_FILES_PERMS+=	/dev/null ${VARBASE}/games/emacs/tetris-scores \
			${GAMES_USER} ${GAMES_GROUP} ${GAMEDATAMODE:Q}
SPECIAL_PERMS+=		libexec/emacs/${PKGVERSION_NOREV}/${MACHINE_GNU_PLATFORM}/update-game-score ${SETGID_GAMES_PERMS}
.endif

.if (${OPSYS} == "DragonFly") && exists(/usr/lib/crtn.o)
CPPFLAGS+=		-DDFLY_CRT_USRLIB
.endif

.include "../../mk/compiler.mk"

# "emacs" uses the C pre-processor to generate makefiles. The C pre-processor
# of newer GCC version is designed to break this by purpose. We work around
# that using the traditional mode to generate makefiles.
.if ${OPSYS} != "OpenVMS" && !empty(CC_VERSION:Mgcc-[4-9].*)
CPP+=			-P
CONFIGURE_ENV+=		CPP=${CPP:Q}
.endif

.if (${OPSYS} == "NetBSD") && \
    !exists(/usr/lib/libgcc_s.so) && !exists(/usr/lib/libgcc.a)
# NetBSD with native Clang doesn't provide libgcc, everything is in libc.
pre-configure: fake-libgcc

LDFLAGS+=		-L${PREFIX}/lib
fake-libgcc:
	${AR} q ${BUILDLINK_DIR}/lib/libgcc.a
.endif

.if ${OPSYS} != "OpenVMS"
post-extract:
	cp ${FILESDIR}/site-init.el ${WRKSRC}/lisp
	cp ${FILESDIR}/dragonfly.h ${WRKSRC}/src/s
	${CHMOD} -R go-w ${WRKSRC}

# These dirs are installed by tar-copy and can sometimes come out mode
# 754, which if PKG_DEVELOPER is set causes the build to fail.
post-install:
.for file in leim leim/ja-dic leim/quail
	${CHMOD} 755 ${DESTDIR}${PREFIX}/share/emacs/${PKGVERSION_NOREV}/${file}
.endfor
.endif

.if ${OPSYS} != "OpenVMS"
.include "../../mk/oss.buildlink3.mk"
.include "../../mk/termcap.buildlink3.mk"
.endif
