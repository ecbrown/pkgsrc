;;; Commentary:

;; The second one.  Not installed.
;;
;; This is extremely lame at the moment.

;;; Code:

(erase-buffer)
(make-mms-derivative-insert-raw-data 0)
(insert "\n")
(make-mms-derivative-insert-raw-data 1)
(make-mms-derivative-data 'write-under-root "descrip.mms_in")

;;;---------------------------------------------------------------------------
;;; data

;;;0;;# DIST: This is the distribution Makefile for Emacs.  configure can
;;;0;;# DIST: make most of the changes to this file you might want, so try
;;;0;;# DIST: that first.
;;;0;;
;;;0;;# mms all	to compile and build Emacs.
;;;0;;# mms install	to install it.
;;;0;;# mms TAGS	to update tags tables.
;;;0;;#
;;;0;;# mms clean  or  mms mostlyclean
;;;0;;#      Delete all files from the current directory that are normally
;;;0;;#      created by building the program.	 Don't delete the files that
;;;0;;#      record the configuration.  Also preserve files that could be made
;;;0;;#      by building, but normally aren't because the distribution comes
;;;0;;#      with them.
;;;0;;#
;;;0;;#      Delete `.dvi' files here if they are not part of the distribution.
;;;0;;#
;;;0;;# mms distclean
;;;0;;#      Delete all files from the current directory that are created by
;;;0;;#      configuring or building the program.  If you have unpacked the
;;;0;;#      source and built the program without creating any other files,
;;;0;;#      `mms distclean' should leave only the files that were in the
;;;0;;#      distribution.
;;;0;;#
;;;0;;# mms realclean
;;;0;;#      Delete everything from the current directory that can be
;;;0;;#      reconstructed with this Makefile.  This typically includes
;;;0;;#      everything deleted by distclean, plus more: C source files
;;;0;;#      produced by Bison, tags tables, info files, and so on.
;;;0;;#
;;;0;;# mms extraclean
;;;0;;#      Still more severe - delete backup and autosave files, too.
;;;0;;
;;;0;;SHELL = /bin/sh
;;;0;;
;;;0;;# If Make doesn't predefine MAKE, set it here.
;;;0;;@SET_MAKE@
;;;0;;
;;;0;;# ==================== Things `configure' Might Edit ====================
;;;0;;
;;;0;;CC=@CC@
;;;0;;CPP=@CPP@
;;;0;;C_SWITCH_SYSTEM=@c_switch_system@
;;;0;;ALLOCA=@ALLOCA@
;;;0;;LN_S=@LN_S@
;;;0;;CFLAGS=@CFLAGS@
;;;0;;C_SWITCH_X_SITE=@C_SWITCH_X_SITE@
;;;0;;LD_SWITCH_X_SITE=@LD_SWITCH_X_SITE@
;;;0;;LOADLIBES=@libsrc_libs@
;;;0;;YACC=@YACC@
;;;0;;
;;;0;;### These help us choose version- and architecture-specific directories
;;;0;;### to install files in.
;;;0;;
;;;0;;### This should be the number of the Emacs version we're building,
;;;0;;### like `18.59' or `19.0'. version_us holds the same value, with
;;;0;;### the dot exchanged to an underscore.
;;;0;;version=@version@
;;;0;;version_us=@version_us@
;;;0;;
;;;0;;### This should be the name of the configuration we're building Emacs
;;;0;;### for, like `mips-dec-ultrix' or `sparc-sun-sunos'.
;;;0;;configuration=@configuration@
;;;0;;
;;;0;;# ==================== Where To Install Things ====================
;;;0;;
;;;0;;# N.B.: As VMS has a stronger knowledge of disks, and things might
;;;0;;# be hard to handle, we use three variables for each directory
;;;0;;# specification:
;;;0;;#	foo		holding the whole specification
;;;0;;#	foo_dev		holding the device part (always has a colon)
;;;0;;#	foo_dir		holding the directory (no brackets) part
;;;0;;
;;;0;;# The default location for installation.  Everything is placed in
;;;0;;# subdirectories of this directory.  The default values for many of
;;;0;;# the variables below are expressed in terms of this one, so you may
;;;0;;# not need to change them.  This defaults to /usr/local.
;;;0;;prefix=@prefix@
;;;0;;
;;;0;;# Like `prefix', but used for architecture-specific files.
;;;0;;exec_prefix=@exec_prefix@
;;;0;;
;;;0;;# Where to install Emacs and other binaries that people will want to
;;;0;;# run directly (like etags).
;;;0;;bindir=@bindir@
;;;0;;
;;;0;;# Where to install architecture-independent data files.
;;;0;;# $(lispdir) and $(etcdir) are subdirectories of this.
;;;0;;datadir=@datadir@
;;;0;;
;;;0;;# Where to install and expect the files that Emacs modifies as it
;;;0;;# runs.  These files are all architecture-independent. Right now, the
;;;0;;# only such data is the locking directory; $(lockdir) is a
;;;0;;# subdirectory of this.
;;;0;;statedir=@statedir@
;;;0;;
;;;0;;# Where to install and expect executable files to be run by Emacs
;;;0;;# rather than directly by users, and other architecture-dependent
;;;0;;# data.  $(archlibdir) is a subdirectory of this.
;;;0;;libdir=@libdir@
;;;0;;
;;;0;;# Where to install Emacs's man pages, and what extension they should have.
;;;0;;mandir=@mandir@
;;;0;;manext=.HLP
;;;0;;
;;;0;;# Where to install and expect the info files describing Emacs.
;;;0;;# In the past, this defaulted to a subdirectory of
;;;0;;# $(prefix)/lib/emacs, but since there are now many packages
;;;0;;# documented with the texinfo system, it is inappropriate to imply
;;;0;;# that it is part of Emacs.
;;;0;;infodir=@infodir@
;;;0;;
;;;0;;# Where to find the source code.  The source code for Emacs's C kernel is
;;;0;;# expected to be in $(srcdir)/src, and the source code for Emacs's
;;;0;;# utility programs is expected to be in $(srcdir)/lib-src.  This is
;;;0;;# set by the configure script's `--srcdir' option.
;;;0;;srcdir=@srcdir@
;;;0;;
;;;0;;# Where to find some usefull VMS scripts.
;;;0;;vmssrcdir=@srcdir_dev@[@srcdir_dir@.VMS]
;;;0;;
;;;0;;# Where to find the lisp directory.
;;;0;;lispsrcdir=@srcdir_dev@[@srcdir_dir@.LISP]
;;;0;;
;;;0;;# Tell make where to find source files; this is needed for the makefiles.
;;;0;;# Unfortunatelly, MMS does not use this...
;;;0;;VPATH=@srcdir@
;;;0;;
;;;0;;# ==================== Emacs-specific directories ====================
;;;0;;
;;;0;;# These variables hold the values Emacs will actually use.  They are
;;;0;;# based on the values of the standard Make variables above.
;;;0;;
;;;0;;# Where to install the lisp files distributed with
;;;0;;# Emacs.  This includes the Emacs version, so that the
;;;0;;# lisp files for different versions of Emacs will install
;;;0;;# themselves in separate directories.
;;;0;;lispdir=@lispdir@
;;;0;;
;;;0;;# Directories Emacs should search for lisp files specific
;;;0;;# to this site (i.e. customizations), before consulting
;;;0;;# $(lispdir).  This should be a colon-separated list of
;;;0;;# directories.
;;;0;;locallisppath=@locallisppath@
;;;0;;
;;;0;;# Where Emacs will search to find its lisp files.  Before
;;;0;;# changing this, check to see if your purpose wouldn't
;;;0;;# better be served by changing locallisppath.  This
;;;0;;# should be a comma-separated list of directories.
;;;0;;lisppath=@lisppath@
;;;0;;
;;;0;;# Where Emacs will search for its lisp files while
;;;0;;# building.  This is only used during the process of
;;;0;;# compiling Emacs, to help Emacs find its lisp files
;;;0;;# before they've been installed in their final location.
;;;0;;# It's usually identical to lisppath, except that
;;;0;;# it does not include locallisppath, and the
;;;0;;# entry for the directory containing the installed lisp
;;;0;;# files has been replaced with ../lisp.  This should be a
;;;0;;# comma-separated list of directories.
;;;0;;buildlisppath=$(locallisppath),[-.lisp],$(lispsrcdir)
;;;0;;
;;;0;;# Where to install the other architecture-independent
;;;0;;# data files distributed with Emacs (like the tutorial,
;;;0;;# the cookie recipes and the Zippy database). This path
;;;0;;# usually contains the Emacs version number, so the data
;;;0;;# files for multiple versions of Emacs may be installed
;;;0;;# at once.
;;;0;;etcdir=@etcdir@
;;;0;;
;;;0;;# Where to create and expect the locking directory, where
;;;0;;# the Emacs locking code keeps track of which files are
;;;0;;# currently being edited.
;;;0;;lockdir=@lockdir@
;;;0;;
;;;0;;# Where to put executables to be run by Emacs rather than
;;;0;;# the user.  This path usually includes the Emacs version
;;;0;;# and configuration name, so that multiple configurations
;;;0;;# for multiple versions of Emacs may be installed at
;;;0;;# once.
;;;0;;archlibdir=@archlibdir@
;;;0;;
;;;0;;# Where to put the docstring file.
;;;0;;docdir=@docdir@
;;;0;;
;;;0;;# Where to install and expect VMS-specific files to be run
;;;0;;# by Emacs rather than the user.
;;;0;;vmslibdir=@vmslibdir@
;;;0;;
;;;0;;# Where to install the startup script, which sets up logical names.
;;;0;;startupdir=@startupdir@
;;;0;;
;;;0;;# Where to install the DECWindows vue script, which you may use to start
;;;0;;# Emacs from the window manager menu.
;;;0;;vuelibdir=@vuelibdir@
;;;0;;
;;;0;;# ==================== Utility Programs for the Build ====================
;;;0;;
;;;0;;# Allow the user to specify the install program.
;;;0;;INSTALL = @INSTALL@
;;;0;;INSTALL_PROGRAM = @INSTALL_PROGRAM@
;;;0;;INSTALL_DATA = @INSTALL_DATA@
;;;0;;INSTALL_DATA_QUOTED = @INSTALL_DATA_QUOTED@
;;;0;;
;;;0;;# ============================= Targets ==============================
;;;0;;
;;;0;;# What emacs should be called when installed.
;;;0;;EMACS = emacs
;;;0;;
;;;0;;# Subdirectories to make recursively.  `lisp' is not included
;;;0;;# because the compiled lisp files are part of the distribution
;;;0;;# and you cannot remake them without installing Emacs first.
;;;0;;SUBDIR = [.vms],[.lib-src],[.src]
;;;0;;
;;;0;;# The makefiles of the directories in $SUBDIR.
;;;0;;SUBDIR_MAKEFILES = [.lib-src]descrip.mms,[.src]descrip.mms,-
;;;0;;[.oldXMenu]descrip.mms,[.vms]descrip.mms, [.lwlib]descrip.mms
;;;0;;
;;;0;;# Subdirectories to install, and where they'll go.
;;;0;;# lib-src's makefile knows how to install it, so we don't do that here.
;;;0;;# When installing the info files, we need to do special things to
;;;0;;# avoid nuking an existing dir file, so we don't do that here;
;;;0;;# instead, we have written out explicit code in the `install' targets.
;;;0;;COPYDIR = @srcdir_dev@[@srcdir_dir@.ETC],@srcdir_dev@[@srcdir_dir@.LISP]
;;;0;;COPYDESTS = $(etcdir),$(lispdir)
;;;0;;
;;;0;;#all : paths-force [.vms]runtemacs.com [.vms]vmslink.opt \
;;;0;;#	setup_config [.vms]rebuild.com $(SUBDIR)
;;;0;;#	@ !
;;;0;;all : paths-force [.vms]runtemacs.com [.vms]vmslink.opt \
;;;0;;	setup_config $(SUBDIR)
;;;0;;	@ !
;;;0;;
;;;0;;debug : set_debug all
;;;0;;	@ !
;;;0;;
;;;0;;set_debug : FRC.debug
;;;0;;	all = "all_debug"
;;;0;;
;;;0;;removenullpaths=sed -e 's/^://' -e 's/:$$//' -e 's/::/:/'
;;;0;;
;;;0;;# Diverse TPU procedures we might use.
;;;0;;[.vms]routines.tpu$section : $(vmssrcdir)routines.tpu
;;;0;;	set def [.vms]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) routines.tpu$section
;;;0;;	set def [-]
;;;0;;
;;;0;;# Note that sed is not in /bin on 386bsd.
;;;0;;[.src]paths.h : descrip.mms @srcdir_dev@[@srcdir_dir@.SRC]paths.h_in -
;;;0;;		FRC.src.paths.h [.vms]routines.tpu$section
;;;0;;	@ write sys$output "Producing `[.src]paths.h' from `@srcdir_dev@[@srcdir_dir@.SRC]paths.h_in'."
;;;0;;	@ open/write foo paths.tpu_tmp
;;;0;;	@ write foo "lisppath := removenullpaths (""$(lisppath)"");"
;;;0;;	@ write foo "buildlisppath := removenullpaths (""$(buildlisppath)"");"
;;;0;;	@ write foo "input_file:=GET_INFO(COMMAND_LINE, ""file_name"");"
;;;0;;	@ write foo "main_buffer := CREATE_BUFFER (""main"", input_file);"
;;;0;;	@ write foo "p_0_or_more_spc := (span("" ""+ASCII(9)) | """");"
;;;0;;	@ write foo "position (beginning_of (main_buffer));"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_LOADSEARCH"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + lisppath + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_DUMPLOADSEARCH"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + buildlisppath + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_EXEC"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(archlibdir)"" + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_INFO"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(infodir)"" + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_DATA"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(etcdir)"" + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_DOC"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(docdir)"" + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_LOCK"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(lockdir)"" + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""TERMCAP_NAME"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(etcdir)TERMCAP.SRC"" + """""""");"
;;;0;;	@ write foo "write_file(main_buffer, get_info (command_line, ""output_file""));"
;;;0;;	@ write foo "quit;"
;;;0;;	@ close foo
;;;0;;	@ save_mesg = f$environment("MESSAGE")
;;;0;;	@ set message/nofacility/noidentification/noseverity/notext
;;;0;;	@ edit/tpu/section=sys$disk:[.vms]routines.tpu$section/nodisplay -
;;;0;;		/command=paths.tpu_tmp/out=[.src]paths.h_tmp -
;;;0;;		@srcdir_dev@[@srcdir_dir@.SRC]paths.h_in
;;;0;;	@ delete paths.tpu_tmp;*
;;;0;;	@ set message'save_mesg'
;;;0;;	@ @$(srcdir)move-if-change [.src]paths.h_tmp [.src]paths.h
;;;0;;
;;;0;;# For `mms all',
;;;0;;# we force the rebuilding of src/paths.h because the user might give
;;;0;;# make different values for the various directories.  Since we use
;;;0;;# move-if-change, src/paths.h only actually changes if the user did
;;;0;;# something notable, so the only unnecessary work we do is in building
;;;0;;# src/paths.h.tmp, which isn't much.
;;;0;;paths-force : FRC.src.paths.h [.vms]routines.tpu$section
;;;0;;	@ write sys$output "Producing `[.src]paths.h' from `@srcdir_dev@[@srcdir_dir@.SRC]paths.h_in'."
;;;0;;	@ open/write foo paths.tpu_tmp
;;;0;;	@ write foo "lisppath := removenullpaths (""$(lisppath)"");"
;;;0;;	@ write foo "buildlisppath := removenullpaths (""$(buildlisppath)"");"
;;;0;;	@ write foo "input_file:=GET_INFO(COMMAND_LINE, ""file_name"");"
;;;0;;	@ write foo "main_buffer := CREATE_BUFFER (""main"", input_file);"
;;;0;;	@ write foo "p_0_or_more_spc := (span("" ""+ASCII(9)) | """");"
;;;0;;	@ write foo "position (beginning_of (main_buffer));"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_LOADSEARCH"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + lisppath + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_DUMPLOADSEARCH"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + buildlisppath + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_EXEC"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(archlibdir)"" + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_INFO"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(infodir)"" + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_DATA"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(etcdir)"" + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_DOC"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(docdir)"" + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""PATH_LOCK"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(lockdir)"" + """""""");"
;;;0;;	@ write foo "TPU_substitute(LINE_BEGIN + ""#"" + unanchor +"
;;;0;;	@ write foo "               ""TERMCAP_NAME"","
;;;0;;	@ write foo "               unanchor, LINE_END,"
;;;0;;	@ write foo "               "" """""" + ""$(etcdir)TERMCAP.SRC"" + """""""");"
;;;0;;	@ write foo "write_file(main_buffer, get_info (command_line, ""output_file""));"
;;;0;;	@ write foo "quit;"
;;;0;;	@ close foo
;;;0;;	@ save_mesg = f$environment("MESSAGE")
;;;0;;	@ set message/nofacility/noidentification/noseverity/notext
;;;0;;	@ edit/tpu/section=sys$disk:[.vms]routines.tpu$section/nodisplay -
;;;0;;		/command=paths.tpu_tmp/out=[.src]paths.h_tmp -
;;;0;;		@srcdir_dev@[@srcdir_dir@.SRC]paths.h_in
