;;;0;;[.vms]runtemacs.com : descrip.mms
;;;0;;	@ write sys$output "Producing `[.vms]runtemacs.com'."
;;;0;;	@ open/write foo [.vms]runtemacs.com_tmp
;;;0;;	@ write foo "$! This is a subcommand to testemacs.com."
;;;0;;	@ write foo "$! It was automatically generated."
;;;0;;	@ write foo "$! Do NOT run this directly.  Instead, run testemacs.com"
;;;0;;	@ write foo "$! and use the symbols `runtemacs' and `runtemacs_d'."
;;;0;;	@ write foo "$ proc_dir = f$parse(""A.;0"",f$environment(""PROCEDURE"")) - ""A.;0"""
;;;0;;	@ lisp_dir := @srcdir_dev@[@srcdir_dir@.LISP]
;;;0;;	@ termcap_dir := @srcdir_dev@[@srcdir_dir@.ETC]
;;;0;;	@ info_dir := @srcdir_dev@[@srcdir_dir@.INFO]
;;;0;;	@ a = f$environment("DEFAULT")
;;;0;;	@ set default [.lib-src]
;;;0;;	@ lib_src_dir = f$environment("DEFAULT")
;;;0;;	@ set default [-.etc]
;;;0;;	@ etc_dir = f$environment("DEFAULT")
;;;0;;	@ set default 'a'
;;;0;;	@ write foo "$ args = """""
;;;0;;	@ write foo "$ if args .nes. """" .or. p8 .nes. """" then args = p8 + "" "" + args"
;;;0;;	@ write foo "$ if args .nes. """" .or. p7 .nes. """" then args = p7 + "" "" + args"
;;;0;;	@ write foo "$ if args .nes. """" .or. p6 .nes. """" then args = p6 + "" "" + args"
;;;0;;	@ write foo "$ if args .nes. """" .or. p5 .nes. """" then args = p5 + "" "" + args"
;;;0;;	@ write foo "$ if args .nes. """" .or. p4 .nes. """" then args = p4 + "" "" + args"
;;;0;;	@ write foo "$ if args .nes. """" .or. p3 .nes. """" then args = p3 + "" "" + args"
;;;0;;	@ write foo "$ if args .nes. """" .or. p2 .nes. """" then args = p2 + "" "" + args"
;;;0;;	@ write foo "$ define/user EMACSLOADPATH ""''lisp_dir',$(lisppath)"""
;;;0;;	@ write foo "$ define/user EMACSPATH ""''lib_src_dir'"""
;;;0;;	@ write foo "$ define/user EMACSDATA ""''etc_dir'"""
;;;0;;	@ write foo "$ define/user EMACSDOC ""''etc_dir'"""
;;;0;;	@ write foo "$ define/user TERMCAP ""''termcap_dir'TERMCAP.SRC"""
;;;0;;	@ write foo "$ define/user INFOPATH ""''info_dir'"""
;;;0;;	@ write foo "$ define/user SYS$INPUT SYS$COMMAND"
;;;0;;	@ write foo "$ mcr 'proc_dir'temacs'p1' -map 'proc_dir'temacs'p1'.dump 'args'"
;;;0;;	@ write foo "$ exit"
;;;0;;	@ close foo
;;;0;;	@ @$(srcdir)move-if-change [.vms]runtemacs.com_tmp [.vms]runtemacs.com
;;;0;;
;;;0;;[.vms]vmslink.opt : descrip.mms
;;;0;;	@ write sys$output "Producing `[.vms]vmslink.opt'."
