;;;1;;#### Bootstrapping.
;;;1;;
;;;1;;### This is meant for Emacs maintainers only.  It first cleans the
;;;1;;### lisp subdirectory, removing all compiled Lisp files.  Then a
;;;1;;### special emacs executable is built from Lisp sources, which is then
;;;1;;### used to compile Lisp files.  The last step is a "normal" make.
;;;1;;
;;;1;;#- .PHONY: bootstrap
;;;1;;#- .PHONY: maybe_bootstrap
;;;1;;
;;;1;;FRC.bootstrap :
;;;1;;	@ !
;;;1;;FRC.bootstrap-clean-before :
;;;1;;	@ !
;;;1;;
;;;1;;bootstrap : bootstrap-clean-before info FRC.bootstrap
;;;1;;	! (cd lisp; $(MAKE) $(MMSQUALIFIERS) bootstrap-clean)
;;;1;;	set default [.src]
;;;1;;	$(MAKE) $(MMSQUALIFIERS) bootstrap
;;;1;;	directory/date/size/width=(filename=25) bootstrap-emacs.*
;;;1;;	buildsrcdir = f$environment("DEFAULT")
;;;1;;	set default [-]
;;;1;;	a = f$environment("DEFAULT")
;;;1;;	set default $(lispsrcdir)
;;;1;;	mms/macro=("BUILDSRCDIR='buildsrcdir'") bootstrap
;;;1;;	set default 'a'
;;;1;;	! (cd src; $(MAKE) $(MMSQUALIFIERS) mostlyclean)
;;;1;;	$(MAKE) $(MMSQUALIFIERS) all
;;;1;;	! (cd lisp; $(MAKE) $(MMSQUALIFIERS) bootstrap-after)
;;;1;;
;;;1;;bootstrap-clean-before :
;;;1;;	@ ! do nothing for now --ttn
;;;1;;
;;;1;;### Used for `bootstrap' to avoid deleting existing dumped Emacs executables.
;;;1;;ORIG-bootstrap-clean-before : FRC.bootstrap-clean-before
;;;1;;	(cd src;      $(MAKE) $(MMSQUALIFIERS) mostlyclean)
;;;1;;	(cd oldXMenu; $(MAKE) $(MMSQUALIFIERS) clean)
;;;1;;	(cd lwlib;    $(MAKE) $(MMSQUALIFIERS) clean)
;;;1;;	(cd lib-src;  $(MAKE) $(MMSQUALIFIERS) clean)
;;;1;;	-(cd man &&   $(MAKE) $(MMSQUALIFIERS) clean)
;;;1;;	-(cd lispref &&   $(MAKE) $(MMSQUALIFIERS) clean)
;;;1;;	-(cd lispintro &&   $(MAKE) $(MMSQUALIFIERS) clean)
;;;1;;	(cd leim;     $(MAKE) $(MMSQUALIFIERS) clean)

;;; Makefile.in-2mms ends here
