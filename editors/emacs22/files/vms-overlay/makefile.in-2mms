;;;0;;# ==================== Installation ====================
;;;0;;
;;;0;;## If we let lib-src do its own installation, that means we
;;;0;;## don't have to duplicate the list of utilities to install in
;;;0;;## this Makefile as well.
;;;0;;
;;;0;;## On AIX, use tar xBf.
;;;0;;## On Xenix, use tar xpf.
;;;0;;
;;;0;;#.PHONY: install mkdir
;;;0;;
;;;0;;## We delete each directory in $(COPYDESTS) before we copy into it;
;;;0;;## that way, we can reinstall over directories that have been put in
;;;0;;## place with their files read-only (perhaps because they are checked
;;;0;;## into RCS).  In order to make this safe, we make sure that the
;;;0;;## source exists and is distinct from the destination.
;;;0;;install : [.vms]vmslink.opt $(SUBDIR) \
;;;0;;		install-arch-dep install-arch-indep \
;;;0;;		install-doc installdatabase
;;;0;;	@ !
;;;0;;
;;;0;;installdatabase : setup_config [.vms]emacs_startup.com
;;;0;;	@ @$(vmssrcdir)gnu_install_startup emacs $(version) -
;;;0;;		[.vms]emacs_startup.com $(startupdir) DATABASE
;;;0;;
;;;0;;install_no_database : [.vms]vmslink.opt $(SUBDIR) \
;;;0;;		install-arch-dep install-arch-indep \
;;;0;;		install-doc installstartup
;;;0;;	@ !
;;;0;;
;;;0;;installstartup : setup_config [.vms]emacs_startup.com
;;;0;;	@$(vmssrcdir)gnu_install_startup emacs $(version) -
;;;0;;		[.vms]emacs_startup.com $(startupdir) NODATABASE
;;;0;;
;;;0;;[.vms]emacs_startup.com : [.vms]emacs_startup.dat
;;;0;;	@ write sys$output "Producing `[.vms]emacs_startup.com' from `$(vmssrcdir)emacs_startup.dat'."
;;;0;;	@ @$(vmssrcdir)gnu_generate_script [.vms]emacs_startup.dat -
;;;0;;		[.vms]emacs_startup.com_tmp
;;;0;;	@ @$(srcdir)move-if-change [.vms]emacs_startup.com_tmp [.vms]emacs_startup.com
;;;0;;
;;;0;;[.vms]emacs_startup.dat : [.vms]config.dat $(vmssrcdir)emacs_startup.dat_in
;;;0;;	@ write sys$output "Producing `[.vms]emacs_startup.dat' from `$(vmssrcdir)emacs_startup.dat_in' and `[.vms]config.dat'."
;;;0;;	@ @$(vmssrcdir)gnu_generate_data $(vmssrcdir)emacs_startup.dat_in -
;;;0;;		[.vms]config.dat [.vms]emacs_startup.dat_tmp
;;;0;;	@ @$(srcdir)move-if-change [.vms]emacs_startup.dat_tmp -
;;;0;;		[.vms]emacs_startup.dat
;;;0;;
;;;0;;### Note that we copy the DOC-* files from the build etc directory
;;;0;;### as well as lots of things from $(srcdir)/etc.
;;;0;;install-arch-dep : mkdir
;;;0;;	set def [.lib-src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) install
;;;0;;	set def [-]
;;;0;;	$(INSTALL_PROGRAM) [.vms]temacs.exe $(bindir)emacs-$(version_us).exe /log
;;;0;;	$(INSTALL_PROGRAM) [.vms]temacs.dump $(bindir)emacs-$(version_us).dump /log
;;;0;;	! $(INSTALL_PROGRAM) [.vms]rebuild.com $(bindir)rebuild-emacs-$(version_us).com /log
;;;0;;	- purge/keep=2 $(bindir)emacs-$(version_us).exe,.dump /log
;;;0;;	- ! purge $(bindir)rebuild-emacs-$(version_us).com /log
;;;0;;	if f$search ("[.lib-src]fns-*.el") .nes. "" -
;;;0;;	  then $(INSTALL_DATA) [.lib-src]fns-*.el $(archlibdir) /log
;;;0;;	@ !
;;;0;;
;;;0;;### Note that we copy the DOC-* files from the build etc directory
;;;0;;### as well as lots of things from ${srcdir}/etc.
;;;0;;install-arch-indep : mkdir
;;;0;;	@ ! Had to split this one up a little too...
;;;0;;	@ ! THIS IS COMPLETE STUPIDITY!!!!!
;;;0;;	@ !line1 = "result = """""
;;;0;;	@ !line2 = "delete/sym/local result"
;;;0;;	@ !line3 = "@$(vmssrcdir)compare_dirs 'dir1' 'dir2' result"
;;;0;;	@ !line4 = "dest = """""
;;;0;;	@ !line5 = "delete/sym/local dest"
;;;0;;	@ !line6 = "@$(vmssrcdir)dirfilename 'dir1' dest"
;;;0;;	@ !line7 = "if .not. result .and. dest .nes. """" then @$(vmssrcdir)recurdel 'dest'
;;;0;;	@ !@$(vmssrcdir)loop_args2 dir1 dir2 "$(COPYDESTS)" "$(COPYDIR)" "," "'line1';'line2';'line3';'line4';'line5';'line6';'line7'" ";" verbose
;;;0;;	@ !
;;;0;;	@ ! Had to split this one up a little too...
;;;0;;	@ line1 = "create/dir 'dest'"
;;;0;;	@ line2 = "result = """""
;;;0;;	@ line3 = "delete/sym/local result"
;;;0;;	@ line4 = "@$(vmssrcdir)compare_dirs 'dir' 'dest' result"
;;;0;;	@ line5 = "if result then result = f$search(dir+""*.*"") .nes. """""
;;;0;;	@ line6 = "sdir=dir-""]"""
;;;0;;	@ line7 = "sdest=dest-""]"""
;;;0;;	@ line8 = "if .not. result then write sys$output ""Copying "",dir"
;;;0;;	@ line9 = "if .not. result then @$(vmssrcdir)copy 'sdir'...]*.* 'sdest'...]/prot=(o:rwed,w:re)/log"
;;;0;;	@ line10 = "if .not. result then purge 'sdest'...]/log"
;;;0;;	@ write sys$output "blahblah"
;;;0;;	@ @$(vmssrcdir)loop_args2 dest dir "$(COPYDESTS)" "$(COPYDIR)" "," "'line1';'line2';'line3';'line4';'line5';'line6';'line7';'line8';'line9';'line10'" ";" verbose
;;;0;;	@ !
;;;0;;	@ result = "" ! So we do not get a stupid message on the next line...
;;;0;;	-@ delete/sym/local result
;;;0;;	@$(vmssrcdir)compare_dirs @srcdir_dev@[@srcdir_dir@.INFO] $(infodir) result
;;;0;;	if .not.result then -
;;;0;;		if f$search("$(infodir)dir.") .eqs. "" -
;;;0;;			.and.f$search("@srcdir_dev@[@srcdir_dir@.INFO]dir.") .nes. "" then -
;;;0;;				$(INSTALL_DATA) @srcdir_dev@[@srcdir_dir@.INFO]dir. $(infodir)dir. /log
;;;0;;	if .not.result then -
;;;0;;		@$(vmssrcdir)loop_args f "ada-mode*.* autotype*.* ccmode*.* cl*.* dired-x*.* ebrowse*.* ediff*.* efaq*.* emacs*.* eshell*.* eudc*.* forms*.* gnus*.* idlwave*.* info*.* message*.* mh-e*.* pcl-cvs*.* reftex*.* sc*.* speedbar*.* vip*.* widget*.* woman*.*" " " "$(INSTALL_DATA_QUOTED) @srcdir_dev@[@srcdir_dir@.INFO]'f' $(infodir) /log" ";" verbose
;;;0;;	- if .not.result then purge $(infodir) /log
;;;0;;	@ result = "" ! So we do not get a stupid message on the next line...
;;;0;;	-@ delete/sym/local result
;;;0;;	@$(vmssrcdir)compare_dirs $(vmssrcdir) $(vmslibdir) result
;;;0;;	if .not.result then -
;;;0;;		$(INSTALL_PROGRAM) $(vmssrcdir)kepteditor.com $(vmslibdir) /log
;;;0;;	- if .not.result then purge $(vmslibdir)/log
;;;0;;	sdir = f$env("DEFAULT") - "]" + ".VMS]"
;;;0;;	@ !
;;;0;;	! @$(vmssrcdir)compare_dirs 'sdir' $(vuelibdir) result
;;;0;;	! if .not.result then -
;;;0;;	!	$(INSTALL_PROGRAM) [.vms]emacs_vue.com $(vuelibdir)emacs_vue-$(version_us).com /log
;;;0;;	! - if .not.result then purge $(vuelibdir)emacs_vue.com /log
;;;0;;	@ !
;;;0;;	@ ! GNU.HLB is shared; retain EMACS.HLP without modifying that library.
;;;0;;
;;;0;;install-doc : mkdir
;;;0;;	sdir=f$environment("DEFAULT")-"]"+".ETC]"
;;;0;;	@ result = "" ! So we do not get a stupid message on the next line...
;;;0;;	-@ delete/sym/local result
;;;0;;	@ write sys$output "Copying [.etc]DOC*.* ..."
;;;0;;	@$(vmssrcdir)copy [.etc]doc*.* $(docdir) /prot=(o:rwed,w:re)/log
;;;0;;	purge $(docdir)doc*.* /log
;;;0;;
;;;0;;### Build all the directories we're going to install Emacs in.	Since
;;;0;;### we may be creating several layers of directories (for example,
;;;0;;### /usr/local/lib/emacs/19.0/mips-dec-ultrix4.2), we use make-path
;;;0;;### instead of mkdir.  Not all systems' mkdirs have the `-p' flag.
;;;0;;### VMS needs it as well, to take several arguments...
;;;0;;mkdir : FRC.mkdir
;;;0;;	create/dir/prot=(s:rwed,o:rwed,g:re,w:re) $(COPYDESTS)
;;;0;;	create/dir/prot=(s:rwed,o:rwed,g:rwe,w:rwe) $(lockdir)
;;;0;;	create/dir/prot=(s:rwed,o:rwed,g:re,w:re) $(infodir),\
;;;0;;		$(mandir),$(bindir),$(datadir),$(docdir),$(libdir),\
;;;0;;		$(locallisppath),$(vmslibdir),$(startupdir),$(vuelibdir)
;;;0;;
;;;0;;### Delete all the installed files that the `install' target would
;;;0;;### create (but not the noninstalled files such as `make all' would
;;;0;;### create).
;;;0;;###
;;;0;;### Don't delete the lisp and etc directories if they're in the source tree.
;;;0;;uninstall :
;;;0;;	set def [.lib-src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) uninstall
;;;0;;	set def [-]
;;;0;;	@ line1 = "result = """""
;;;0;;	@ line2 = "delete/sym/local result"
;;;0;;	@ line3 = "@$(vmssrcdir)compare_dirs 'dir' $(srcdir) result"
;;;0;;	@ line4 = "dest = """""
;;;0;;	@ line5 = "delete/sym/local dest"
;;;0;;	@ line6 = "@$(vmssrcdir)dirfilename 'dir' dest"
;;;0;;	@ line7 = "if dest .nes. """" then @$(vmssrcdir)recurdel 'dest'
;;;0;;	@ line8 = "if dest - ""@datadir_dev@[@datadir_dir@.EMACS.$(version_us)"" .nes. dest then @$(vmssrcdir)recurdel @datadir_dev@[@datadir_dir@.EMACS]$(version_us).DIR"
;;;0;;	@ @$(vmssrcdir)loop_args dir "$(lispdir),$(etcdir)" "," "'line1';'line2';'line3';'line4';'line5';'line6';'line7';'line8'" ";" verbose
;;;0;;	- delete $(infodir)cl*.*;*,emacs*.*;*,forms*.*;*,info*.*;*,vip*.*;*
;;;0;;	- delete $(bindir)emacs-$(version_us).exe;*,.dump;*
;;;0;;
;;;0;;
;;;0;;### Some makes seem to remember that they've built something called FRC,
;;;0;;### so you can only use a given FRC once per makefile.
;;;0;;FRC :
;;;0;;	@ !
;;;0;;FRC.src.paths.h :
;;;0;;	@ !
;;;0;;FRC.src :
;;;0;;	@ !
;;;0;;FRC.lib-src :
;;;0;;	@ !
;;;0;;FRC.vms :
;;;0;;	@ !
;;;0;;FRC.mkdir :
;;;0;;	@ !
;;;0;;FRC.mostlyclean :
;;;0;;	@ !
;;;0;;FRC.clean :
;;;0;;	@ !
;;;0;;FRC.distclean :
;;;0;;	@ !
;;;0;;FRC.realclean :
;;;0;;	@ !
;;;0;;FRC.debug :
;;;0;;	@ !
;;;0;;
;;;0;;# ==================== Cleaning up and miscellanea ====================
;;;0;;
;;;0;;#.PHONY: mostlyclean clean distclean realclean extraclean
;;;0;;
;;;0;;### `mostlyclean'
;;;0;;###      Like `clean', but may refrain from deleting a few files that people
;;;0;;###      normally don't want to recompile.  For example, the `mostlyclean'
;;;0;;###      target for GCC does not delete `libgcc.a', because recompiling it
;;;0;;###      is rarely necessary and takes a lot of time.
;;;0;;mostlyclean : FRC.mostlyclean
;;;0;;	set def [.src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) mostlyclean
;;;0;;	set def [-]
;;;0;;	set def [.oldXMenu]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) mostlyclean
;;;0;;	set def [-]
;;;0;;	set def [.lwlib]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) mostlyclean
;;;0;;	set def [-]
;;;0;;	set def [.lib-src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) mostlyclean
;;;0;;	set def [-]
;;;0;;	! skip this for now --ttn, 2004-04-28
;;;0;;	! set def [.man]
;;;0;;	! $(MAKE) $(MMSQUALIFIERS) mostlyclean
;;;0;;	! set def [-]
;;;0;;	set def [.vms]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) mostlyclean
;;;0;;	set def [-]
;;;0;;
;;;0;;### `clean'
;;;0;;###      Delete all files from the current directory that are normally
;;;0;;###      created by building the program.  Don't delete the files that
;;;0;;###      record the configuration.  Also preserve files that could be made
;;;0;;###      by building, but normally aren't because the distribution comes
;;;0;;###      with them.
;;;0;;###
;;;0;;###      Delete `.dvi' files here if they are not part of the distribution.
;;;0;;clean : FRC.clean
;;;0;;	set def [.src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) clean
;;;0;;	set def [-]
;;;0;;	set def [.oldXMenu]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) clean
;;;0;;	set def [-]
;;;0;;	set def [.lwlib]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) clean
;;;0;;	set def [-]
;;;0;;	set def [.lib-src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) clean
;;;0;;	set def [-]
;;;0;;	! skip this for now --ttn, 2004-04-28
;;;0;;	! set def [.man]
;;;0;;	! $(MAKE) $(MMSQUALIFIERS) clean
;;;0;;	! set def [-]
;;;0;;	set def [.vms]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) clean
;;;0;;	set def [-]
;;;0;;
;;;0;;### `distclean'
;;;0;;###      Delete all files from the current directory that are created by
;;;0;;###      configuring or building the program.  If you have unpacked the
;;;0;;###      source and built the program without creating any other files,
;;;0;;###      `make distclean' should leave only the files that were in the
;;;0;;###      distribution.
;;;0;;top_distclean=\
;;;0;;	rm -f config.status build-install ; \
;;;0;;	rm -f Makefile $(SUBDIR_MAKEFILES) ; \
;;;0;;	(cd lock ; rm -f *)
;;;0;;distclean : FRC.distclean
;;;0;;	set def [.src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) distclean
;;;0;;	set def [-]
;;;0;;	set def [.oldXMenu]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) distclean
;;;0;;	set def [-]
;;;0;;	set def [.lwlib]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) distclean
;;;0;;	set def [-]
;;;0;;	set def [.lib-src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) distclean
;;;0;;	set def [-]
;;;0;;	set def [.man]
;;;0;;	- $(MAKE) $(MMSQUALIFIERS) distclean
;;;0;;	set def [-]
;;;0;;	set def [.vms]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) distclean
;;;0;;	set def [-]
;;;0;;	@$(vmssrcdir)delete config.status,build-install.
;;;0;;	@$(vmssrcdir)delete descrip.mms,$(SUBDIR_MAKEFILES)
;;;0;;	set def [.lock]
;;;0;;	@$(vmssrcdir)delete *.*
;;;0;;	set def [-]
;;;0;;
;;;0;;
;;;0;;### `realclean'
;;;0;;###      Delete everything from the current directory that can be
;;;0;;###      reconstructed with this Makefile.  This typically includes
;;;0;;###      everything deleted by distclean, plus more: C source files
;;;0;;###      produced by Bison, tags tables, info files, and so on.
;;;0;;###
;;;0;;###      One exception, however: `make realclean' should not delete
;;;0;;###      `configure' even if `configure' can be remade using a rule in the
;;;0;;###      Makefile.  More generally, `make realclean' should not delete
;;;0;;###      anything that needs to exist in order to run `configure' and then
;;;0;;###      begin to build the program.
;;;0;;realclean : FRC.realclean
;;;0;;	set def [.src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) realclean
;;;0;;	set def [-]
;;;0;;	set def [.oldXMenu]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) realclean
;;;0;;	set def [-]
;;;0;;	set def [.lwlib]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) realclean
;;;0;;	set def [-]
;;;0;;	set def [.lib-src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) realclean
;;;0;;	set def [-]
;;;0;;	set def [.man]
;;;0;;	- $(MAKE) $(MMSQUALIFIERS) realclean
;;;0;;	set def [-]
;;;0;;	set def [.vms]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) realclean
;;;0;;	set def [-]
;;;0;;	@$(vmssrcdir)delete config.status,build-install.
;;;0;;	@$(vmssrcdir)delete descrip.mms,$(SUBDIR_MAKEFILES)
;;;0;;	set def [.lock]
;;;0;;	@$(vmssrcdir)delete *.*
;;;0;;	set def [-]
;;;0;;
;;;0;;### This doesn't actually appear in the coding standards, but Karl
;;;0;;### says GCC supports it, and that's where the configuration part of
;;;0;;### the coding standards seem to come from.  It's like distclean, but
;;;0;;### it deletes backup and autosave files too.
;;;0;;extraclean :
;;;0;;!	for i in $(SUBDIR); do (cd $$i; $(MAKE) $(MFLAGS) extraclean); done
;;;0;;	@$(vmssrcdir)loop_args i "$(SUBDIR)" "," "set def 'i';$(MAKE) $(MMSQUALIFIERS) extraclean; set def [-]" ";"
;;;0;;!	-(cd lock; rm *)
;;;0;;!	-rm config.status config-tmp-*
;;;0;;!	-rm -f *~ \/#*
;;;0;;	- @$(vmssrcdir)delete [.lock]*.*
;;;0;;	- @$(vmssrcdir)delete config.status,config-tmp-*.*
;;;0;;	- @$(vmssrcdir)delete _$$*$$.,_$$*.*$$
;;;0;;	- purge
;;;0;;
;;;0;;### Unlocking and relocking.  The idea of these productions is to reduce
;;;0;;### hassles when installing an incremental tar of Emacs.  Do `make unlock'
;;;0;;### before unlocking the file to take the write locks off all sources so
;;;0;;### that tar xvof will overwrite them without fuss.  Then do `make relock'
;;;0;;### afterward so that VC mode will know which files should be checked in
;;;0;;### if you want to mung them.
;;;0;;###
;;;0;;### Note: it's no disaster if these productions miss a file or two; tar
;;;0;;### and VC will swiftly let you know if this happens, and it is easily
;;;0;;### corrected.
;;;0;;SOURCES = ChangeLog.,GETTING.GNU_SOFTWARE,INSTALL.,descrip.mms_in,PROBLEMS., \
;;;0;;	README.,build-install.in,configure.com,make-dist.com,move-if-change.com
;;;0;;
;;;0;;unlock :
;;;0;;	set file/prot=(o:rwed) $(srcdir)$(SOURCES)
;;;0;;	set def [.elisp]
;;;0;;	-set file/prot=(o:rwed) descrip.mms,@srcdir_dev@[@srcdir_dir@.ELISP]README.,*.texi
;;;0;;	set def [-]
;;;0;;	set def [.etc]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) unlock
;;;0;;	set def [-]
;;;0;;	set def [.lib-src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) unlock
;;;0;;	set def [-]
;;;0;;	set def [.lisp]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) unlock
;;;0;;	set def [-]
;;;0;;	set def [.lisp.term]
;;;0;;	set file/prot=o:rwed @srcdir_dev@[@srcdir_dir@.lisp.term]README.,*.el
;;;0;;	set def [-]
;;;0;;	set def [.man]
;;;0;;	set file/prot=o:rwed @srcdir_dev@[@srcdir_dir@.MAN]*.texi*,ChangeLog.,split-man.com
;;;0;;	set def [-]
;;;0;;	set def [.oldXMenu]
;;;0;;	set file/prot=o:rwed descrip.mms,@srcdir_dev@[@srcdir_dir@.oldXMenu]*.c,*.h,README.
;;;0;;	set def [-]
;;;0;;	set def [.lwlib]
;;;0;;	set file/prot=o:rwed descrip.mms,@srcdir_dev@[@srcdir_dir@.LWLIB]*.c,*.h,README.
;;;0;;	set def [-]
;;;0;;	set def [.src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) unlock
;;;0;;	set def [-]
;;;0;;
;;;0;;relock :
;;;0;;	set file/prot=(o:re) $(srcdir)$(SOURCES)
;;;0;;	set def [.elisp]
;;;0;;	-set file/prot=(o:re) descrip.mms,@srcdir_dev@[@srcdir_dir@.ELISP]README.,*.texi
;;;0;;	set def [-]
;;;0;;	set def [.etc]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) relock
;;;0;;	set def [-]
;;;0;;	set def [.lib-src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) relock
;;;0;;	set def [-]
;;;0;;	set def [.lisp]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) relock
;;;0;;	set def [-]
;;;0;;	set def [.lisp.term]
;;;0;;	set file/prot=(o:re) @srcdir_dev@[@srcdir_dir@.lisp.term]README.,*.el
;;;0;;	set def [-]
;;;0;;	set def [.man]
;;;0;;	set file/prot=(o:re) @srcdir_dev@[@srcdir_dir@.MAN]*.texi*,ChangeLog.,split-man.com
;;;0;;	set def [-]
;;;0;;	set def [.oldXMenu]
;;;0;;	set file/prot=(o:re) descrip.mms,@srcdir_dev@[@srcdir_dir@.oldXMenu]*.c,*.h,README.
;;;0;;	set def [-]
;;;0;;	set def [.lwlib]
;;;0;;	set file/prot=(o:re) descrip.mms,@srcdir_dev@[@srcdir_dir@.LWLIB]*.c,*.h,README.
;;;0;;	set def [-]
;;;0;;	set def [.src]
;;;0;;	$(MAKE) $(MMSQUALIFIERS) relock
;;;0;;	set def [-]
;;;0;;
